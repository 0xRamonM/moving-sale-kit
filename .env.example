# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables
# (DATABASE_URL and BLOB_READ_WRITE_TOKEN are added for you when you connect Neon and Blob storage).

# Neon Postgres connection string
DATABASE_URL=

# Vercel Blob read/write token (public store), used for photo uploads from the admin
BLOB_READ_WRITE_TOKEN=

# Password for /admin
ADMIN_PASSWORD=

# Long random string that signs the admin cookie: openssl rand -hex 32
SESSION_SECRET=

# Anthropic API key for the buyer chat bot: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: PostHog project key (EU cloud) for session recordings and funnels
NEXT_PUBLIC_POSTHOG_KEY=

# Optional: your public URL if you use a custom domain (on Vercel it's detected automatically)
NEXT_PUBLIC_SITE_URL=
